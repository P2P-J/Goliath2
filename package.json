{
  "name": "goliath",
  "version": "0.1.0",
  "description": "macOS 개인용 음성 AI 비서",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "engine": "cd engine && .venv/bin/python -m goliath_engine",
    "mic": "cd engine && .venv/bin/python ../bench/mic_test.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.235",
    "@anthropic-ai/sdk": "^0.117.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
